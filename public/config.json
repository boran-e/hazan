{
  "version": "1.1.0",
  "defaultWsUrl": "wss://152.70.50.130.sslip.io",
  "platforms": [
    {
      "id": "netflix",
      "name": "Netflix",
      "hostIncludes": ["netflix.com"],
      "watchPathRegex": "\\/watch\\/(\\d+)",
      "prefix": "",
      "shareUrlTemplate": "https://www.netflix.com/watch/{id}?hazan={room}",
      "profilePaths": ["/login"],
      "profileSelectors": "[data-uia=\"profile-gate-container\"], .profiles-gate-container, .list-profiles",
      "playerMode": "netflix",
      "layoutMode": "css",
      "layoutCss": ".watch-video, .watch-video--player-view, [data-uia=\"video-canvas\"] { width: calc(100vw - 330px) !important; max-width: calc(100vw - 330px) !important; transition: width 0.2s ease !important; }",
      "adDetection": false
    },
    {
      "id": "disneyplus",
      "name": "Disney+",
      "hostIncludes": ["disneyplus.com"],
      "watchPathRegex": "\\/(?:play|video)\\/([A-Za-z0-9_-]+)",
      "prefix": "dp:",
      "shareUrlTemplate": "https://www.disneyplus.com/play/{id}?hazan={room}",
      "profilePaths": ["/login", "/select-profile", "/identity/", "/enter-pin"],
      "profileSelectors": "[data-testid=\"select-profile\"], [data-testid=\"profile-avatar-list\"]",
      "playerMode": "shadow_html5",
      "layoutMode": "dp_fit",
      "adDetection": true,
      "adSelectors": [
        "ad-badge-overlay",
        "ad-countdown",
        "ad-timer",
        "[data-testid*=\"ad-badge\"]",
        "[data-testid*=\"ad-countdown\"]",
        "[data-testid*=\"ad-timer\"]",
        "[data-testid*=\"ad-overlay\"]",
        "[data-testid*=\"ad-label\"]",
        "[data-testid*=\"ad-pod\"]",
        "[data-testid=\"ad-break\"]",
        ".ad-badge-overlay",
        ".ad-countdown",
        ".ad-overlay",
        "[class*=\"ad-badge\"]",
        "[class*=\"AdBadge\"]",
        "[class*=\"adBadge\"]",
        "[class*=\"ad-countdown\"]",
        "[class*=\"adCountdown\"]",
        "[data-ad=\"true\"]",
        "[data-is-ad=\"true\"]"
      ],
      "adTextRegex": "^(reklam|ad)\\b"
    },
    {
      "id": "primevideo",
      "name": "Prime Video",
      "hostIncludes": ["primevideo.com", "amazon.com"],
      "watchPathRegex": "\\/(?:detail|gp\\/video\\/detail)\\/([A-Za-z0-9._-]+)",
      "prefix": "pv:",
      "shareUrlTemplate": "https://www.primevideo.com/detail/{id}?hazan={room}",
      "profilePaths": ["/ap/signin", "/profiles"],
      "profileSelectors": "[data-testid=\"profile-picker\"], .profiles-picker, [data-automation-id=\"profile-picker\"]",
      "playerMode": "shadow_html5",
      "layoutMode": "css",
      "layoutCss": "#dv-web-player, .dv-player-fullscreen, .webPlayerSDKContainer, .atvwebplayersdk-player-container, .cascadesContainer { width: calc(100vw - 330px) !important; max-width: calc(100vw - 330px) !important; right: auto !important; transition: width 0.2s ease !important; }",
      "adDetection": true,
      "adSelectors": [
        ".atvwebplayersdk-adtimeindicator-text",
        ".atvwebplayersdk-ad-timer-text",
        ".atvwebplayersdk-adbadge-text",
        ".atvwebplayersdk-adskip-button",
        "[class*=\"adtimeindicator\"]",
        "[class*=\"ad-countdown\"]",
        "[class*=\"adCountdown\"]",
        "[data-testid*=\"ad-countdown\"]",
        "[data-testid*=\"ad-timer\"]",
        "[data-testid*=\"ad-badge\"]",
        "[data-testid*=\"ad-label\"]",
        "[data-ad=\"true\"]",
        "[data-is-ad=\"true\"]"
      ],
      "adTextRegex": "^(reklam|ad|sponsorlu)\\b"
    }
  ]
}